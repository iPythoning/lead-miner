# 网关（线索池入口，一次双写企微 SCRM + trade-crm）
# 网关 ingest 只在内网；先开隧道 ssh -N -L 18090:127.0.0.1:18090 aliyun
GATEWAY_URL=http://127.0.0.1:18090
OUTBOUND_SITE_KEY=

# 工商补全（可选；未配置时自动降级为 NoopEnricher，链路照常跑通）
# 端点不写死在代码里 —— 拿到真实凭据后填这里即可。{name} 会被替换成公司名。
ENRICH_API_URL=
ENRICH_API_KEY=
ENRICH_AUTH_HEADER=Authorization
ENRICH_AUTH_PREFIX=
ENRICH_FIELD_MAP={"credit_code":"data.creditCode","scope":"data.scope","staff_size":"data.employeeCount"}
